{
  "name": "ming-harness-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "electron .",
    "desktop:dev": "node electron/desktop-dev.cjs",
    "verify:win-runtime": "node scripts/verify-win-runtime.mjs",
    "verify:public-package": "node scripts/verify-public-package.mjs",
    "prepare:win-runtime": "node scripts/prepare-win-runtime.mjs",
    "build:desktop-runtime": "node scripts/build-desktop-runtime.mjs",
    "dist:win:green": "npm run build && npm run build:desktop-runtime && electron-builder --config electron-builder.win-green.yml --win dir zip --x64 && npm run verify:public-package",
    "dist:win:installer": "npm run build && npm run build:desktop-runtime && electron-builder --config electron-builder.win.yml --win nsis --x64 && npm run verify:public-package release/win-installer/win-unpacked"
  },
  "dependencies": {
    "@lucide/vue": "^1.28.0",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.3.0",
    "monaco-editor": "^0.52.2",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "vite": "^8.1.5"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
